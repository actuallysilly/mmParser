; ── antiCC ────────────────────────────────────────────────────────────────────
; Types a random amount in 199.00-200.00, two decimals, so the figure is never
; the same twice.
;
; Both bounds live here rather than in the call: if the round 200.00 endpoint
; turns out to defeat the point, narrowing to 19999 is a one-character edit.
ANTICC_MIN_CENTS := 19900
ANTICC_MAX_CENTS := 20000

; Randomises whole CENTS, not a float. Random(199.0, 200.0) returns a double, and
; formatting one to two places rounds 199.996 up to "200.00" — the values at the
; edges would come up more often than the ones in between.
AntiCcAmount()
{
    global ANTICC_MIN_CENTS, ANTICC_MAX_CENTS
    cents := Random(ANTICC_MIN_CENTS, ANTICC_MAX_CENTS)
    return Format("{1}.{2:02}", cents // 100, Mod(cents, 100))
}

AntiCc()
{
    SendText(AntiCcAmount())
}

HK_Bind("general.antiCc", AntiCc)

; ── __curr ────────────────────────────────────────────────────────────────────
; Today's PPV name: 25 July 2026 -> "725".
;
; The month drops its leading zero but the day always keeps two digits, so
; 5 December is "1205" and cannot be misread as 12 May.
PpvNameToday()
{
    return FormatTime(, "M") . FormatTime(, "dd")
}

